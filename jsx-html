#!/usr/bin/env bash
# Converts a Claude Desktop JSX artifact into a standalone HTML file
# that runs directly in the browser via CDN-loaded React + Babel.
#
# Usage: jsx-html input.jsx [output.html]
#   If output is omitted, writes to input.html alongside the .jsx file.
#
# Forked from https://gist.github.com/ericboehs/1dd34d61540272a37dbe6e9d2aba60dd

set -euo pipefail

if [[ $# -lt 1 ]]; then
    echo "Usage: jsx-to-html input.jsx [output.html]"
    exit 1
fi

INPUT="$1"

if [[ ! -f "$INPUT" ]]; then
    echo "Error: File not found: $INPUT"
    exit 1
fi

OUTPUT="${2:-${INPUT%.jsx}.html}"
TMP=$(mktemp)

cleanup() {
    rm -f "$TMP"
}
trap cleanup EXIT

# Detect exported component ##################################################

COMPONENT=$(
    grep -oE '^export default function[[:space:]]+[A-Za-z_][A-Za-z0-9_]*' "$INPUT" \
    | head -1 \
    | awk '{print $4}'
)

if [[ -z "$COMPONENT" ]]; then
    COMPONENT=$(
        grep -oE '^export default[[:space:]]+[A-Z][A-Za-z0-9_]*' "$INPUT" \
        | head -1 \
        | awk '{print $3}'
    )
fi

if [[ -z "$COMPONENT" ]]; then
    echo "Error: Could not determine default exported component."
    exit 1
fi

# Pretty title ###############################################################

TITLE=$(printf "%s" "$COMPONENT" | sed -E '
s/([a-z])([A-Z])/\1 \2/g
s/([A-Z]+)([A-Z][a-z])/\1 \2/g
s/([A-Za-z])([0-9])/\1 \2/g
')

# Gather imports #############################################################

declare -a SEEN
PACKAGES=()
IMPORT_LINES=()

while IFS= read -r line; do

    IMPORT_LINES+=("$line")

    pkg=$(printf "%s\n" "$line" \
        | sed -nE 's/.*from[[:space:]]+["'\'']([^"'\'']+)["'\''].*/\1/p')

    [[ -z "$pkg" ]] && continue

    case "$pkg" in
        react|react-dom|react-dom/client)
            continue
            ;;

        ./*|../*|/*)
            echo "Warning: relative import '$pkg' copied unchanged."
            continue
            ;;

        *.css|*.scss|*.sass|*.less)
            continue
            ;;
    esac

    [[ -n "${SEEN[$pkg]:-}" ]] && continue

    SEEN[$pkg]=1
    PACKAGES+=("$pkg")

done < <(grep -E '^[[:space:]]*import[[:space:]]' "$INPUT")

# Import map #################################################################

IMPORTMAP_EXTRAS=""

if (( ${#PACKAGES[@]} != 0 )); then
    for pkg in "${PACKAGES[@]}"; do
        IMPORTMAP_EXTRAS+=$(
            printf '\n      "%s": "https://esm.sh/%s?external=react",' \
                "$pkg" "$pkg"
        )
    done
fi

IMPORTMAP_EXTRAS="${IMPORTMAP_EXTRAS%,}"

# React hook detection #######################################################

HOOKS=()

for hook in useState useEffect useMemo useCallback useRef useLayoutEffect useReducer useContext; do
    if grep -q "\\<$hook\\>" "$INPUT"; then
        HOOKS+=("$hook")
    fi
done

if ((${#HOOKS[@]})); then
    REACT_IMPORT=", { $(IFS=', '; echo "${HOOKS[*]}") }"
else
    REACT_IMPORT=""
fi

# Tailwind detection #########################################################

USE_TAILWIND=0

if grep -Eq 'className *= *["'\'']' "$INPUT"; then
    USE_TAILWIND=1
fi

# Strip imports / export #####################################################

JSX_BODY=$(
    sed \
        -e '/^[[:space:]]*import[[:space:]]/d' \
        -e 's/^export default function /function /' \
        -e 's/^export default //' \
        "$INPUT"
)

# Begin output ###############################################################

cat >"$TMP" <<EOF
<!--
Generated by claude-jsx-to-html
Source: $(basename "$INPUT")
-->

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>$TITLE</title>
EOF

if ((USE_TAILWIND)); then
cat >>"$TMP" <<'EOF'
<script src="https://cdn.tailwindcss.com"></script>
EOF
fi

cat >>"$TMP" <<EOF
<script type="importmap">
{
  "imports": {
    "react": "https://esm.sh/react@18",
    "react/jsx-runtime": "https://esm.sh/react@18/jsx-runtime",
    "react-dom/client": "https://esm.sh/react-dom@18/client"${IMPORTMAP_EXTRAS:+,$IMPORTMAP_EXTRAS}
  }
}
</script>

<script src="https://unpkg.com/@babel/standalone@7/babel.min.js"></script>

<style>
html, body, #root {
    margin: 0;
    padding: 0;
    height: 100%;
}
</style>

</head>

<body>

<div id="root"></div>

<script type="text/babel" data-type="module">
import React$REACT_IMPORT from 'react';
import { createRoot } from 'react-dom/client';

EOF

# Copy non-react imports #####################################################

for line in "${IMPORT_LINES[@]}"; do

    case "$line" in
        *from\ \"react\"*|*from\ \'react\'*)
            continue
            ;;

        *from\ \"react-dom*|*from\ \'react-dom*)
            continue
            ;;

        *\"*.css\"*|*\'*.css\'*)
            continue
            ;;

        *\"*.scss\"*|*\'*.scss\'*)
            continue
            ;;
    esac

    echo "$line" >>"$TMP"

done

# Component ##################################################################

cat >>"$TMP" <<EOF

$JSX_BODY

const root = createRoot(document.getElementById('root'));
root.render(<$COMPONENT />);

</script>

</body>
</html>
EOF

mv "$TMP" "$OUTPUT"

echo
echo "Created:   $OUTPUT"
echo "Component: $COMPONENT"

if ((${#PACKAGES[@]})); then
    echo "Packages:  ${PACKAGES[*]}"
else
    echo "Packages:  none"
fi

if ((USE_TAILWIND)); then
    echo "Tailwind:  enabled"
else
    echo "Tailwind:  not detected"
fi